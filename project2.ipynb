   "source": [
    "import numpy as np\n",
    "salary = np.array([\n",
    "    25000, 32000, 45000, 28000,\n",
    "    60000, 52000, 35000, 70000\n",
    "])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "e6a4ea46",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['Normal' 'Normal' 'Normal' 'Normal' 'High' 'High' 'Normal' 'High']\n"
     ]
    }
   ],
   "source": [
    "category = np.where(\n",
    "    salary >= 50000,\n",
    "    \"High\",\n",
    "    \"Normal\"\n",
    ")\n",
    "\n",
    "print(category)"
   ]
  }
 ],
